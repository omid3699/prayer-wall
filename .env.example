# Copy this file to .env and fill values for local development or CI.
# Do NOT commit .env

SECRET_KEY=changeme_replace_with_secure_random
DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///./db.sqlite3

# Example for production with Postgres:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Email (optional)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=user
# EMAIL_HOST_PASSWORD=pass
# EMAIL_USE_TLS=1
